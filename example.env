BOT_TOKEN=""
key=""
GEMINI_API_KEY=""

# Optional runtime config
ADMIN_ID=1076078800
DB_FILE=data.db
BOT_USERNAME=nzdiary_bot
LOG_LEVEL=INFO
GEMINI_MODEL=gemini-3.5-flash-lite
# Google refuses this datacenter's outbound IP (400 FAILED_PRECONDITION,
# "User location is not supported") while the same key works from a home
# connection. Requests go through our own Cloudflare Worker instead — see
# deploy/gemini-proxy.worker.js. Leave empty to talk to Google directly.
# The secret guards the free request quota, not the key: the key is never
# stored in the worker, it just rides along in the request.
GEMINI_BASE_URL=
GEMINI_PROXY_SECRET=

# Cookie Merge on the same host: whoever opens the game through our link
# (?startapp=src_nz) and registers there gets a week of VIP here.
# Empty PARTNER_TOKEN turns the exchange off. The same value must sit in
# PARTNER_TOKEN in /opt/cookie/.env — that is the token the game checks.
PARTNER_TOKEN=""
COOKIE_API_URL=http://127.0.0.1:8000
COOKIE_SOURCE=nz
COOKIE_VIP_DAYS=7
# The link shown on the button. Must carry ?startapp=src_<COOKIE_SOURCE> —
# without it the visit is not attributed at all and nobody gets paid.
COOKIE_LINK=https://t.me/CookieMerge_bot?startapp=src_nz

# Optional Naurok helper auth. Leave empty unless you use that admin-only helper.
NAUROK_COOKIE=""
NAUROK_CSRF_TOKEN=""
